{
  "permissions": {
    "allow": [
      "Read(~/.agents/**)",
      "Read(~/.claude/**)",
      "Bash(command -v *)",
      "Bash(echo \"* $?\")",
      "Bash(fd --version)",
      "Bash(gh auth status)",
      "Bash(gh auth status --active)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh label list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh repo view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh search issues *)",
      "Bash(git --version)",
      "Bash(git check-ignore *)",
      "Bash(git --no-pager diff *)",
      "Bash(git diff *)",
      "Bash(git fetch origin *)",
      "Bash(git log *)",
      "Bash(git ls-remote *)",
      "Bash(git status *)",
      "Bash(git worktree list *)",
      "Bash(jq --version)",
      "Bash(just --list)",
      "Bash(node --version)",
      "Bash(npm org ls *)",
      "Bash(npm view *)",
      "Bash(npm whoami *)",
      "Bash(pnpm --version:*)",
      "Bash(pnpm exec prettier:*)",
      "Bash(pnpm run:*)",
      "Bash(rg:*)",
      "Bash(tilt get *)",
      "Bash(tilt logs *)",
      "Bash(tmux list-panes *)",
      "Bash(tmux list-windows *)",
      "mcp__claude_ai_Google_Calendar__list_events",
      "mcp__claude_ai_Linear__get_issue",
      "mcp__claude_ai_Linear__get_project",
      "mcp__claude_ai_Linear__get_status_updates",
      "mcp__claude_ai_Linear__list_comments",
      "mcp__claude_ai_Linear__list_issue_labels",
      "mcp__claude_ai_Linear__list_issue_statuses",
      "mcp__claude_ai_Linear__list_issues",
      "mcp__claude_ai_Linear__list_milestones",
      "mcp__claude_ai_Linear__list_projects",
      "mcp__claude_ai_Linear__list_teams",
      "mcp__claude_ai_Linear__list_users",
      "mcp__claude-design__list_projects",
      "mcp__claude-design__list_files",
      "mcp__claude-design__read_file"
    ],
    "ask": [
      "Edit(**/package.json)"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/prefer-scripts.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/prefer-gh-native.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/prefer-root-scripts.mjs\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": true
  },
  "effortLevel": "xhigh",
  "theme": "auto",
  "editorMode": "vim"
}
