################################################################################
# Ignore Most Things
################################################################################

/*
/.**

# don't ignore this gitignore
!.gitignore

# and don't ignore the config folder (but keep ignoring everything in it)
!/.config/
/.config/*

################################################################################
# Terminal and Shell
################################################################################

!/.config/ghostty
!/.config/ghostty/*
!/.config/starship.toml
!/.zshrc

# un-ignore any special zsh scripts
!/.zsh/
!/.zsh/*

# ...but keep ignoring secrets
/.zsh/secrets.zsh

# ...and keep ignoring antigen (which should be installed separately)
/.zsh/antigen.zsh

################################################################################
# Vim and Tmux
################################################################################

!/.config/nvim
!/.config/nvim/**

!.tmux.conf

!/.tmux/
!/.tmux/custom/**
/.tmux/plugins/**

# LazyVim ships with a markdown linter, and we have some global config to make
# it less picky about line length for wide tables
!.markdownlint.json

################################################################################
# Coding Agent Config
################################################################################

# Un-ignore the directory, then re-ignore everything in it
!/.claude/
/.claude/*

!/.claude/CLAUDE.md
!/.claude/settings.json
!/.claude/hooks
!/.claude/hooks/**

# Not ready to sync
/.claude/hooks/redirect-gh-api.mjs

# Vendor agent skills into the repo so a fresh checkout has them (the setup
# runner just ensures the ~/.claude/skills symlink). Drop these lines and track
# only .skill-lock.json if you'd rather restore skills from the lock instead.
#
# Un-ignore narrowly: .agents/ is tool-managed, so anything a tool drops in
# later (auth caches, MCP config) stays ignored unless we opt it in here.
!/.agents/
/.agents/*
!/.agents/.skill-lock.json
!/.agents/skills/
!/.agents/skills/**

################################################################################
# Machine setup runner
################################################################################

!/setup/
!/setup/**

# ...but not the installed dev deps, or the lockfile
/setup/node_modules/
/setup/bun.lock

# Employer-specific catalog, not for sync
/setup/work-private.ts

################################################################################
# Window Management
################################################################################

!/.config/yabai
!/.config/yabai/**
!/.config/skhd
!/.config/skhd/**


################################################################################
# Git
################################################################################

!.gitconfig


################################################################################
# Never Track
################################################################################

# This block is last on purpose: later rules win, so these beat every un-ignore
# above and apply inside every un-ignored tree.

# Without this, .DS_Store leaks out of any un-ignored tree — .agents/skills/
# already had one.
.DS_Store

# Belt and braces for a public repo. The un-ignore rules above are recursive in
# places (setup/, .agents/skills/), so secret-shaped files could otherwise be
# swept in by `git add -A` without anyone noticing.
.env
.env.*
*.pem
*.key
*.p12
id_rsa*
id_ed25519*
credentials.json
secrets.*
*_secret*

