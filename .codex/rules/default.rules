prefix_rule(pattern=["npm", "whoami"], decision="allow")
prefix_rule(pattern=["pnpm", "--version"], decision="allow")
prefix_rule(pattern=["pnpm", "exec", "prettier"], decision="allow")
prefix_rule(pattern=["pnpm", "run"], decision="allow")
prefix_rule(pattern=["rg"], decision="allow")
prefix_rule(pattern=["starship", "--version"], decision="allow")
prefix_rule(pattern=["starship", "preset"], decision="allow")
prefix_rule(pattern=["tilt", "get"], decision="allow")
prefix_rule(pattern=["tilt", "logs"], decision="allow")
prefix_rule(pattern=["tmux", "list-panes"], decision="allow")
