# Command approvals. Codex appends new interactive approvals here.

prefix_rule(pattern=["brew", "info"], decision="allow")
prefix_rule(pattern=["command", "-v"], decision="allow")
prefix_rule(pattern=["fd", "--version"], decision="allow")
prefix_rule(pattern=["gh", "--version"], decision="allow")
prefix_rule(pattern=["gh", "auth", "status"], decision="allow")
prefix_rule(pattern=["gh", "extension", "list"], decision="allow")
prefix_rule(pattern=["gh", "issue", "list"], decision="allow")
prefix_rule(pattern=["gh", "issue", "view"], decision="allow")
prefix_rule(pattern=["gh", "label", "list"], decision="allow")
prefix_rule(pattern=["gh", "pr", "checks"], decision="allow")
prefix_rule(pattern=["gh", "pr", "diff"], decision="allow")
prefix_rule(pattern=["gh", "pr", "list"], decision="allow")
prefix_rule(pattern=["gh", "pr", "view"], decision="allow")
prefix_rule(pattern=["gh", "repo", "view"], decision="allow")
prefix_rule(pattern=["gh", "run", "list"], decision="allow")
prefix_rule(pattern=["gh", "run", "view"], decision="allow")
prefix_rule(pattern=["gh", "search", "issues"], decision="allow")
prefix_rule(pattern=["gh", "skill", "list"], decision="allow")
prefix_rule(pattern=["git", "--no-pager", "diff"], decision="allow")
prefix_rule(pattern=["git", "--version"], decision="allow")
prefix_rule(pattern=["git", "check-ignore"], decision="allow")
prefix_rule(pattern=["git", "diff"], decision="allow")
prefix_rule(pattern=["git", "fetch", "--tags", "-q", "origin"], decision="allow")
prefix_rule(pattern=["git", "fetch", "--tags", "origin"], decision="allow")
prefix_rule(pattern=["git", "fetch", "-q", "origin"], decision="allow")
prefix_rule(pattern=["git", "fetch", "origin"], decision="allow")
prefix_rule(pattern=["git", "log"], decision="allow")
prefix_rule(pattern=["git", "ls-remote"], decision="allow")
prefix_rule(pattern=["git", "ls-tree"], decision="allow")
prefix_rule(pattern=["git", "status"], decision="allow")
prefix_rule(pattern=["git", "worktree", "list"], decision="allow")
prefix_rule(pattern=["jq", "--version"], decision="allow")
prefix_rule(pattern=["just", "--list"], decision="allow")
prefix_rule(pattern=["just", "check"], decision="allow")
prefix_rule(pattern=["just", "codegen"], decision="allow")
prefix_rule(pattern=["just", "format"], decision="allow")
prefix_rule(pattern=["just", "lint"], decision="allow")
prefix_rule(pattern=["just", "lint-fix"], decision="allow")
prefix_rule(pattern=["just", "test-integration"], decision="allow")
prefix_rule(pattern=["node", "--version"], decision="allow")
prefix_rule(pattern=["npm", "org", "ls"], decision="allow")
