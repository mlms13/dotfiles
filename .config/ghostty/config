# This is the configuration file for Ghostty.

# Cursor settings
# Keep box (not bar) in vi insert mode
shell-integration-features = no-cursor

# Quick Terminal Shortcut
keybind = global:ctrl+option+space=toggle_quick_terminal

# Colors
theme = dark:TokyoNight Night,light:TokyoNight Day
# theme = dark:Catppuccin Mocha,light:Catppuccin Latte

# Font
font-family = FiraCode Nerd Font Mono

# Don't prompt on close even if a process is running
confirm-close-surface = false

# Restore windows/tabs/splits after relaunch (macOS only)
window-save-state = always
